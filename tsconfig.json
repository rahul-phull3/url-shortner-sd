{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "types": ["node", "@cloudflare/workers-types", "vite/client"]
  },
  "include": [
    "web",
    "server",
    "edge",
    "db",
    "tests",
    "scripts/*.ts",
    "vite.config.ts",
    "drizzle.config.ts"
  ]
}
