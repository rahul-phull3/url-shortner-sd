{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "rewriteRelativeImportExtensions": true,
    "outDir": "build",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["server", "scripts/migrate.ts"],
  "exclude": ["edge", "web", "tests"]
}
